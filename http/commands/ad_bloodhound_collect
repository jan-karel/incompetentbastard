# BloodHound / SharpHound - AD data verzameling voor attack path analyse
# Methode 1: SharpHound.exe (alle methoden)
.\SharpHound.exe --CollectionMethods All --Domain domain.local --ExcludeDomainControllers --OutputDirectory C:\Windows\tasks
# Methode 2: Specifieke collection (minder ruis)
.\SharpHound.exe --CollectionMethods DCOnly --Domain domain.local --OutputDirectory C:\Windows\tasks
# Methode 3: Session collection (wie is waar ingelogd)
.\SharpHound.exe --CollectionMethods Session --Loop --Loopduration 02:00:00
# Methode 4: PowerShell versie
powershell -c "Import-Module .\SharpHound.ps1; Invoke-BloodHound -CollectionMethod All -Domain domain.local -OutputDirectory C:\Windows\tasks"
# Methode 5: Python versie (vanuit Linux, geen creds op target nodig)
bloodhound-python -u user -p 'Password123!' -d domain.local -ns DC_IP -c All
# Na collectie: upload .zip naar BloodHound GUI
# Nuttige queries: Shortest Path to DA, Kerberoastable users, AS-REP roastable
# Tip: --ExcludeDomainControllers voorkomt alerts op DC logons
# Tip: --Stealth optie vermindert detectie (minder queries)