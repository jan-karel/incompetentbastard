% \deelsgelakt{zichtbaar}{geheim}: het eerste deel blijft staan, het tweede
% deel wordt in de gelakte build zwart gemaakt (via \lakken).
\newcommand{\deelsgelakt}[2]{#1\lakken{#2}}

% -------------------------------------------------- %
% Lakken (redactie): gelakte vs. ongelakte versie     %
% -------------------------------------------------- %
% \weglakken schakelt tussen de ongelakte (false) en de gelakte (true) build.
% De gelakte build wordt door de generator gemaakt met \renewcommand{\weglakken}{true}.
\providecommand{\weglakken}{false}
% \xblackout maakt tekst onleesbaar door haar te VERVANGEN door een zwarte balk
% van gelijke breedte. De oorspronkelijke tekst komt niet in de PDF terecht, dus
% er is geen copy-paste-lek (anders dan een zwart vlak boven leesbare tekst).
\newlength{\ib@lakwidth}
\newcommand{\xblackout}[1]{%
  \settowidth{\ib@lakwidth}{#1}%
  % Nooit breder dan de regel: anders loopt een lange redactie de marge in.
  \ifdim\ib@lakwidth>\linewidth\setlength{\ib@lakwidth}{\linewidth}\fi
  \leavevmode\rule[-0.3ex]{\ib@lakwidth}{2.2ex}%
}
\newcommand{\lakken}[1]{\ifthenelse{\equal{\weglakken}{true}}{\xblackout{#1}}{#1}}
\newcommand{\codelakken}[1]{\ifthenelse{\equal{\weglakken}{true}}{\xblackout{#1}}{#1}}
% Veilige placeholder als in de gelakte build geen gelakte kopie bestaat: toont
% nooit het origineel, maar een zwart kader met de tekst [GELAKT].
\newcommand{\iblakplaceholder}{%
  \fcolorbox{black}{black}{\parbox{0.85\textwidth}{\centering
    \vspace{2.5em}\textcolor{white}{\bfseries [GELAKT]\\[0.3em]
    \footnotesize geen gelakte kopie beschikbaar}\vspace{2.5em}}}%
}
% \ibfiguur{normaalpad}{lakpad}{caption}
% Kiest op basis van \weglakken de juiste afbeelding; in de gelakte build nooit
% het origineel (bij ontbrekende lakpad -> \iblakplaceholder).
\newcommand{\ibfiguur}[3]{%
  \begin{figure}[htbp]
    \centering
    \ifthenelse{\equal{\weglakken}{true}}{%
      \IfFileExists{#2}{\ib@grx{#2}}{\iblakplaceholder}%
    }{%
      \IfFileExists{#1}{\ib@grx{#1}}{\textit{[bestand niet gevonden: #1]}}%
    }%
    \caption{#3}
  \end{figure}%
}
% \ib@grx{pad}: afbeelding op standaardbreedte met een subtiele, zachte
% slagschaduw rechtsonder, zodat screenshots van het papier "getild" worden.
% Eén centrale plek: zo krijgen evidence- en \plaatje-afbeeldingen dezelfde stijl.
\newcommand{\ib@grx}[1]{%
  \tikz[baseline]\node[inner sep=0pt,
        blur shadow={shadow blur steps=8, shadow xshift=1pt, shadow yshift=-2pt,
                     shadow opacity=30, shadow blur radius=3pt}]
    {\includegraphics[width=0.9\textwidth,keepaspectratio]{#1}};%
}
% \plaatje{bestand}{caption}: projectafbeelding. De toolbar/plak-functie voegt
% bare bestandsnamen in die in raw/screenshots/ (projectafbeeldingen) of in
% evidence/ kunnen staan. We zoeken beide bronnen af (compile-cwd = rapport/,
% dus ../raw/screenshots/). In de gelakte build komt de gelakte kopie uit de
% lakken/-submap van dezelfde bron; ontbreekt die -> veilige [GELAKT]-placeholder.
\newcommand{\plaatje}[2]{%
  \begin{figure}[htbp]
    \centering
    \ifthenelse{\equal{\weglakken}{true}}{%
      \IfFileExists{../raw/screenshots/lakken/#1}{\ib@grx{../raw/screenshots/lakken/#1}}{%
        \IfFileExists{evidence/lakken/#1}{\ib@grx{evidence/lakken/#1}}{\iblakplaceholder}}%
    }{%
      \IfFileExists{../raw/screenshots/#1}{\ib@grx{../raw/screenshots/#1}}{%
        \IfFileExists{evidence/#1}{\ib@grx{evidence/#1}}{\textit{[bestand niet gevonden: #1]}}}%
    }%
    \caption{#2}
  \end{figure}%
}

% -------------------------------------------------- %
% \ibevidence{pad}{lakpad}{caption}                   %
% -------------------------------------------------- %
\newcommand{\ibevidence}[3]{\ibfiguur{#1}{#2}{#3}}
