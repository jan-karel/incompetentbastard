\newtcolorbox{ibtip}{enhanced,breakable,colback=lichtgroen,colframe=donkergroen,
  colbacktitle=donkergroen,coltitle=white,boxrule=0.6pt,arc=1mm,
  left=4mm,right=4mm,top=3mm,bottom=3mm,title={Tip},fonttitle=\bfseries}
\newtcolorbox{ibopmerking}{enhanced,breakable,colback=hemelblauw,colframe=rijkblauw,
  colbacktitle=rijkblauw,coltitle=white,boxrule=0.6pt,arc=1mm,
  left=4mm,right=4mm,top=3mm,bottom=3mm,title={Opmerking},fonttitle=\bfseries}
\newcommand{\waarschuwing}[1]{\begin{ibwaarschuwing}#1\end{ibwaarschuwing}}
\newcommand{\tip}[1]{\begin{ibtip}#1\end{ibtip}}
\newcommand{\opmerking}[1]{\begin{ibopmerking}#1\end{ibopmerking}}
