% -------------------------------------------------- %
% CVSS -> kleur mapping                              %
% -------------------------------------------------- %
% \ibseveritycolor{score} -> past \ibcurrentcolor EN \ibcurrenttextcolor aan.
% De tekstkleur zorgt voor voldoende contrast: wit op de donkere severities
% (Hoog=ored, Kritiek=opaars), zwart op de lichte (Nihil/Laag/Midden).
\newcommand{\ibcurrentcolor}{ogreen}
\newcommand{\ibcurrenttextcolor}{black}

\newcommand{\ibseveritycolor}[1]{%
  \ifdim #1 pt<0.1pt
    \renewcommand{\ibcurrentcolor}{olichtblauw}\renewcommand{\ibcurrenttextcolor}{black}%
  \else\ifdim #1 pt<4.0pt
    \renewcommand{\ibcurrentcolor}{oyellow}\renewcommand{\ibcurrenttextcolor}{black}%
  \else\ifdim #1 pt<7.0pt
    \renewcommand{\ibcurrentcolor}{oorange}\renewcommand{\ibcurrenttextcolor}{black}%
  \else\ifdim #1 pt<9.0pt
    \renewcommand{\ibcurrentcolor}{ored}\renewcommand{\ibcurrenttextcolor}{white}%
  \else
    \renewcommand{\ibcurrentcolor}{opaars}\renewcommand{\ibcurrenttextcolor}{white}%
  \fi\fi\fi\fi
}

% -------------------------------------------------- %
% CVSS -> label mapping                              %
% -------------------------------------------------- %
\newcommand{\ibseveritylabel}[1]{%
  \ifdim #1 pt<0.1pt
    Nihil%
  \else\ifdim #1 pt<4.0pt
    Laag%
  \else\ifdim #1 pt<7.0pt
    Midden%
  \else\ifdim #1 pt<9.0pt
    Hoog%
  \else
    Kritiek%
  \fi\fi\fi\fi
}

% -------------------------------------------------- %
% Bevinding — body-flow layout                        %
% -------------------------------------------------- %
% Prose (beschrijving/bewijs/impact/aanbeveling) staat NIET meer in een
% tabular-cel (daar lopen itemize/description/lstlisting mank), maar als
% gewone documentstroom. Alleen de metadata zit in een gekleurde tabel.
%
% \ibfindinghead{ID}{Titel}{CVSS}{Categorie}{CWE}{NCSC}
%   -> subsectie + label + compacte metadata-tabel
%      (ID | CATEGORIE | PRIORITEIT | CWE | CVSS). PRIORITEIT-cel gekleurd naar
%      severity met contrasterende tekstkleur. Body volgt in de template.
\newcommand{\ibfindinghead}[6]{%
  \ibseveritycolor{#3}%
  \subsubsection{#2}%
  \label{bev:#1}%
  \nopagebreak
  {\arrayrulecolor{white}%
   \renewcommand{\arraystretch}{1.3}%
   \noindent\begin{tabularx}{\textwidth}{|c|X|c|c|c|c|}
     \hline
     \rowcolor{rijkblauw}\textcolor{white}{\textbf{\small ID}} & \textcolor{white}{\textbf{\small CATEGORIE}} & \textcolor{white}{\textbf{\small PRIORITEIT}} & \textcolor{white}{\textbf{\small CWE}} & \textcolor{white}{\textbf{\small NCSC}} & \textcolor{white}{\textbf{\small CVSS}}\\
     \hline
     \cellcolor{olightgray}#1 & \cellcolor{olightgray}\small #4 & \cellcolor{\ibcurrentcolor}\textbf{\textcolor{\ibcurrenttextcolor}{\ibseveritylabel{#3}}} & \cellcolor{olightgray}#5 & \cellcolor{olightgray}\small #6 & \cellcolor{olightgray}#3\\
     \hline
   \end{tabularx}}%
  \par\vspace{0.6em}%
}
% \ibfindingsection{Kop} -> gestileerde ongenummerde subsubsection met een
%   klein severity-gekleurd vierkant als accent (Impact / Aanbeveling / Bewijs).
\newcommand{\ibfindingsection}[1]{%
  \subsubsection*{\textcolor{\ibcurrentcolor}{\rule[-0.1ex]{0.9ex}{0.9ex}}\hspace{0.5em}#1}%
}
% Compat-wrapper: complete bevinding in body-flow (niet meer gebruikt door de
% Flask-template, maar blijft werken voor eventuele losse aanroepen).
\newcommand{\ibfinding}[6]{%
  \ibfindinghead{#1}{#2}{#3}{}{}{}%
  \par\noindent #4\par
  \ibfindingsection{Impact}\noindent #5\par
  \ibfindingsection{Aanbeveling}\noindent #6\par
  \vspace{0.5em}%
}

% -------------------------------------------------- %
% Haakjes + kruisverwijzingen naar bevindingen        %
% -------------------------------------------------- %
% \haakjes{tekst}: cursief tussen aanhalingstekens (zelfde betekenis als in het
% handboek). Wordt ook door de LaTeX-toolbar ingevoegd en gebruikt door
% \bevinding. \providecommand zodat een bestaande definitie niet botst.
\providecommand{\haakjes}[1]{\textit{`#1'}}
% \bevinding{id}: nette kruisverwijzing naar bevinding <id>. De labels worden
% door \ibfindinghead gezet als bev:<id> (mét dubbele punt), dus daar verwijzen
% we naar. Toont paragraafnummer, naam en paginanummer.
\newcommand{\bevinding}[1]{\textcolor{rijkblauw}{\S\,\ref{bev:#1} \haakjes{\nameref{bev:#1}} (pagina \pageref{bev:#1})}}
% \uitwerking{id}: standaardzin die naar een andere bevinding doorverwijst.
\newcommand{\uitwerking}[1]{We werken deze bevinding verder uit in \bevinding{#1}}
% \bevindingref{id}: korte kruisverwijzing (alleen het paragraafnummer).
\newcommand{\bevindingref}[1]{\textcolor{rijkblauw}{\S\,\ref{bev:#1}}}

% -------------------------------------------------- %
% Technische inline-opmaak (monospace)                %
% -------------------------------------------------- %
% Semantische varianten van \texttt; de LaTeX-toolbar voegt ze in. In HTML/MD
% worden ze <code>/`...`. \providecommand zodat ze niet botsen met het handboek.
\providecommand{\pad}[1]{\texttt{#1}}
\providecommand{\host}[1]{\texttt{#1}}
\providecommand{\route}[1]{\texttt{#1}}
\providecommand{\param}[1]{\texttt{#1}}

% -------------------------------------------------- %
% Codes met klikbare bron (CWE/CVE/OWASP)             %
% -------------------------------------------------- %
% Argument is de KALE code: \cwe{79}, \cve{2024-1234}, \owasp{A03:2025}.
\newcommand{\cwe}[1]{\href{https://cwe.mitre.org/data/definitions/#1.html}{CWE-#1}}
\newcommand{\cve}[1]{\href{https://nvd.nist.gov/vuln/detail/CVE-#1}{CVE-#1}}
\newcommand{\owasp}[1]{\href{https://owasp.org/Top10/}{#1}}

% -------------------------------------------------- %
% CVSS / severity inline-badge                        %
% -------------------------------------------------- %
% \cvss{7.5}: score + severity-label in de severity-kleur, met hetzelfde
% contrast als de bevindingkop (achtergrond \ibcurrentcolor, tekst
% \ibcurrenttextcolor). \severity{woord}: alleen het gekleurde label.
\newcommand{\cvss}[1]{{\ibseveritycolor{#1}\colorbox{\ibcurrentcolor}{\textcolor{\ibcurrenttextcolor}{\textbf{#1\,(\ibseveritylabel{#1})}}}}}
\newcommand{\ib@sevbox}[3]{\colorbox{#1}{\textcolor{#2}{\textbf{#3}}}}
\newcommand{\severity}[1]{%
  \ifthenelse{\equal{#1}{kritiek}}{\ib@sevbox{opaars}{white}{Kritiek}}{%
  \ifthenelse{\equal{#1}{hoog}}{\ib@sevbox{ored}{white}{Hoog}}{%
  \ifthenelse{\equal{#1}{midden}}{\ib@sevbox{oorange}{black}{Midden}}{%
  \ifthenelse{\equal{#1}{laag}}{\ib@sevbox{oyellow}{black}{Laag}}{%
  \ifthenelse{\equal{#1}{nihil}}{\ib@sevbox{olichtblauw}{black}{Nihil}}{%
  \textbf{#1}}}}}}%
}

